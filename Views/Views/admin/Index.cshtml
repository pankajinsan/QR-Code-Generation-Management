@{
    Layout = "~/Views/Shared/_adminLayout.cshtml"; 
    Session["admin"] = "";
}

@*<!DOCTYPE html>*@

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Admin</title>
   
    <script>
        $(document).ready(function () {
            $("#btnlogin").click(function () {
                $("#pageloaddiv").show();
                var username = $("#txtuser").val();
                var pass = $("#txtpass").val();
                $.ajax({
                    type: "Post",
                    url: "../admin/checkdata",
                    data: { "uname": "" + username + "", "pass": "" + pass + "" },
                    success: function (data) {
                        if (data == "Invalid Username.") {
                            $("#txtuser").css("border", "1px solid red");
                            $("#txtpass").css("border", "1px solid #D3CAB1");
                            $("#pageloaddiv").hide();
                        }
                        if(data=="Invalid Password.")
                         {
                            $("#txtpass").css("border", "1px solid red");
                            $("#txtuser").css("border", "1px solid #D3CAB1");
                            $("#pageloaddiv").hide();
                        }
                        if (data == "correct")
                        {
                           // window.location.href = "http://localhost:2607/admin/dashboard";
                             window.location.href = "http://forlagetvektor.org/admin/dashboard";
                           // window.location.href = "http://forlagetvektor.org/admin/vupload";
                            $("#pageloaddiv").hide();
                        }
                      
                    },
                    error: function () {
                    }


                });

            });
			
			      var c = screen.height;
                      c = c - 35;
  
       // $("#bck").css("height", "" + c.toString() + "px");
        });
    </script>
</head>
<body>
    <div id="pageloaddiv"></div>
	<div class="container-fluid" id="bck" style="background-size: cover; background-color: black; background-size: cover; background-image: url('https://unsplash.it/1920/1080?random');height: 100vh !important;overflow: hidden;background-position: center;background-repeat: no-repeat; ">
    <div class="container">
        <div class="row" style="margin-top:200px;">
            <div class="col-lg-3" style="text-align:center;">
            </div>
            <div class="col-lg-6" style="text-align:left;padding: 31px;padding-top:0px;">
                <div class="ban" style="min-height:300px;background-color: #8c8c8c8f;">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="ban" style="background-color:#4D5D6485;;border-bottom: 4px solid #5a5; width: 100%; height: 50px">
                                <label style="padding: 15px; color: white; font-size: 19px;">Login</label>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="margin-top:30px;color:white;">

                        <div class="col-lg-5 " style="text-align: left; padding: 2%; padding-left: 87px;">
                            <label>Name</label>
                        </div>
                        <div class="col-lg-7 " style="">
                            <input type="text" id="txtuser" style="width: 270px !important;" />
                        </div>

                    </div>
                    <div class="row" style="color:white;margin-top:30px;">

                        <div class="col-lg-5 " style="text-align: left; padding: 2%; padding-left: 87px; ">
                            <label>Password</label>
                        </div>
                        <div class="col-lg-7 " style="">
                            <input type="password" id="txtpass" style="width: 270px !important;" />
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-lg-6">

                        </div>
                        <div class="col-lg-6" style="text-align: right; padding-right: 55px;">
                            <button id="btnlogin" class="btn btn-primary btn-video" role="button" style="margin-top: 30px;background-color: #0604047d;color: white;">Login</button>
							
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3" style="text-align:center;">
            </div>
        </div>
    </div>
	</div>
</body>
</html>
